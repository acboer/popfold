<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Popfold</RootNamespace>
    <AssemblyName>Popfold</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Popfold.ico</ApplicationIcon>
    <Product>Popfold</Product>
    <!-- Dados de quem publica (Propriedades > Detalhes). Arquivos sem eles parecem mais suspeitos aos antivírus. -->
    <!-- AssemblyTitle vira a "Descrição do arquivo", que o Gerenciador de Tarefas mostra: mantenha só "Popfold". -->
    <AssemblyTitle>Popfold</AssemblyTitle>
    <Company>acboer</Company>
    <Authors>acboer</Authors>
    <Copyright>Copyright (c) 2026 acboer. MIT License.</Copyright>
    <Description>Android/iOS-style folders for the Windows desktop and taskbar.</Description>
    <PackageProjectUrl>https://github.com/acboer/popfold</PackageProjectUrl>
    <Version>0.4.1</Version>
    <!-- "Versão do produto" limpa (0.4.1), sem o hash do commit colado. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Só as mensagens do .NET em português (inglês já vem embutido): instalador bem menor. -->
    <SatelliteResourceLanguages>pt-BR;pt</SatelliteResourceLanguages>
    <!-- DPI é definido no app.manifest (WPF); o aviso é só do WinForms (usado para o ícone da bandeja). -->
    <!-- WPF0001: ThemeMode (visual Fluent do Windows 11) na janela de opções. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
    <StartupObject>Popfold.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Popfold.ico" />
    <Resource Include="branding/icons/popfold-128.png" />
    <!-- Fredoka e Nunito (OFL). Se a pasta estiver vazia, o app usa a fonte do Windows. -->
    <Resource Include="fonts/*.ttf" />
  </ItemGroup>

</Project>
