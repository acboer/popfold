<Window x:Class="Popfold.FolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popfold"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" AllowDrop="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Fundo quase transparente: a célula inteira recebe clique e arrastar. -->
    <Grid x:Name="Root" Background="#01000000">
        <!-- Destaque de seleção (como os ícones do Windows). -->
        <Border x:Name="SelectionFrame" CornerRadius="10" Margin="2,1,2,1" Visibility="Collapsed"
                Background="#3D66A3FF" BorderBrush="#A066A3FF" BorderThickness="1" />

        <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
            <Grid x:Name="BoxHost" Width="76" Height="76" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>

                <!-- Vidro: o pedaço do papel de parede atrás da pasta, desfocado. -->
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,76,76" RadiusX="20" RadiusY="20" />
                    </Grid.Clip>
                    <Rectangle x:Name="GlassBg" Margin="-24" Visibility="Collapsed">
                        <Rectangle.Effect>
                            <BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance" />
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>

                <Border x:Name="Tint" CornerRadius="20" Background="#5CFFFFFF" />
                <Border x:Name="Stroke" CornerRadius="20" BorderBrush="#66FFFFFF" BorderThickness="1" />

                <UniformGrid x:Name="PreviewGrid" Rows="2" Columns="2" Margin="10" />
                <TextBlock x:Name="EmptyGlyph" Text="+" FontSize="36" FontWeight="Light"
                           Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-6,0,0" />
            </Grid>
            <TextBlock x:Name="Label" Foreground="White" FontSize="12.5" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="6,7,6,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.95" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
