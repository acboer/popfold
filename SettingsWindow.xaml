<Window x:Class="Popfold.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Popfold.ico"
        Background="{StaticResource Fundo}" FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <StackPanel Margin="26,18,26,22">

        <!-- Cabeçalho: ícone + logotipo -->
        <Grid Margin="2,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/branding/icons/popfold-128.png" Width="64" Height="64"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="34" Margin="0,-4,0,0">
                    <Run Text="pop" Foreground="{StaticResource Chiclete}" /><Run Text="fold" Foreground="{StaticResource Uva}" />
                </TextBlock>
                <TextBlock x:Name="TaglineText" Style="{StaticResource Hint}" FontSize="14" FontWeight="Bold" />
            </StackPanel>
        </Grid>

        <!-- Aparência -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="AppearanceHeader" Style="{StaticResource CardTitle}" />

                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource LavandaClara}" Height="26" CornerRadius="13" Padding="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TransparencyValue" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{StaticResource Uva}" />
                    </Border>
                    <TextBlock x:Name="TransparencyLabel" Style="{StaticResource Label}" VerticalAlignment="Center" />
                </DockPanel>
                <Slider x:Name="TransparencySlider" Style="{StaticResource CandySlider}" Minimum="0" Maximum="100"
                        SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,8,0,0" />
                <Grid Margin="0,0,0,16">
                    <TextBlock x:Name="MoreSolidText" Style="{StaticResource Hint}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="MoreClearText" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                </Grid>

                <CheckBox x:Name="GlassCheck" Style="{StaticResource Toggle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="GlassLabel" Style="{StaticResource Label}" />
                        <TextBlock x:Name="GlassHintText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </CheckBox>

                <TextBlock x:Name="StyleLabel" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StyleLightRadio" Style="{StaticResource Segment}" GroupName="style" />
                        <RadioButton x:Name="StyleDarkRadio" Style="{StaticResource Segment}" GroupName="style" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Geral -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="GeneralHeader" Style="{StaticResource CardTitle}" />

                <TextBlock x:Name="LanguageLabel" Style="{StaticResource Label}" Margin="0,0,0,8" />
                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangAutoRadio" Style="{StaticResource Segment}" GroupName="lang" />
                        <RadioButton x:Name="LangPtRadio" Style="{StaticResource Segment}" GroupName="lang" Content="Português" />
                        <RadioButton x:Name="LangEnRadio" Style="{StaticResource Segment}" GroupName="lang" Content="English" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="StartupCheck" Style="{StaticResource Toggle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="StartupLabel" Style="{StaticResource Label}" />
                        <TextBlock x:Name="StartupHintText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </CheckBox>

                <CheckBox x:Name="UpdateCheck" Style="{StaticResource Toggle}">
                    <StackPanel>
                        <TextBlock x:Name="UpdateLabel" Style="{StaticResource Label}" />
                        <TextBlock x:Name="UpdateHintText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TipText" Style="{StaticResource Hint}" Margin="6,0,6,18" />

        <DockPanel>
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}"
                    IsCancel="True" IsDefault="True" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBlock x:Name="NewVersionText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="Collapsed" Cursor="Hand" TextDecorations="Underline"
                           Foreground="{StaticResource Chiclete}" FontWeight="Bold" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
