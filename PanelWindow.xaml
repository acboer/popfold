<Window x:Class="Popfold.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Popfold"
        Title="Popfold"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Left="-10000" Top="-10000" Opacity="0" UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="92" Height="100" CornerRadius="20" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TilePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margem externa = espaço para a sombra. -->
    <Grid x:Name="Root" Margin="28" AllowDrop="True" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border CornerRadius="30" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="{DynamicResource PanelShadow}" Color="#2B1B4A" />
            </Border.Effect>
        </Border>

        <StackPanel Margin="16,14,16,14">
            <TextBox x:Name="TitleBox" Foreground="{DynamicResource PanelText}" Background="Transparent" CaretBrush="{DynamicResource PanelText}" FontFamily="{StaticResource DisplayFont}"
                     FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="10,2,10,12"
                     SelectionBrush="{StaticResource Chiclete}" MaxLength="40">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="2,2,2,3">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PanelLine}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Chiclete}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <ScrollViewer x:Name="ItemsScroll" MaxHeight="440" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="ItemsHost" Focusable="False"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Click="Item_Click"
                                    Opacity="{Binding TileOpacity}"
                                    PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Item_PreviewMouseMove"
                                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="900">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static local:L.Open}" Click="ItemOpen_Click" />
                                        <MenuItem Header="{x:Static local:L.RunAsAdmin}" Click="ItemAdmin_Click"
                                                  Visibility="{Binding FileVisibility}" />
                                        <MenuItem Header="{x:Static local:L.OpenFileLocation}" Click="ItemLocation_Click"
                                                  Visibility="{Binding FileVisibility}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static local:L.RenameItem}" Click="ItemRename_Click" />
                                        <MenuItem Header="{x:Static local:L.RemoveFromFolder}" Click="ItemRemove_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Margin="4,12,4,4">
                                    <Image Source="{Binding Icon}" Width="48" Height="48"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PanelText}" FontSize="12.5" FontWeight="Bold"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,7,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource PanelSubtle}" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" Width="230" Margin="8,6,8,10" />
        </StackPanel>
    </Grid>
</Window>
